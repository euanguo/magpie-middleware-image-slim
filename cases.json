  {
    "name": "Responses: an old screenshot is replaced by a placeholder naming its file",
    "ctx": {
      "agent": "codex",
      "protocol": "responses"
    },
    "options": {
      "keep_last": 0,
      "min_bytes": 0,
      "placeholder": "[screenshot left out: {path}]"
    },
    "request": {
      "model": "m",
      "input": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "start"
            }
          ]
        },
        {
          "type": "function_call",
          "name": "view_image",
          "arguments": "{\"path\":\"/tmp/shot0.png\"}",
          "call_id": "c0"
        },
        {
          "type": "function_call_output",
          "call_id": "c0",
          "output": [
            {
              "type": "input_image",
              "image_url": "data:image/png;base64,AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
              "detail": "high"
            }
          ]
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "now edit the file"
            }
          ]
        }
      ]
    },
    "expect_request": {
      "model": "m",
      "input": [
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "start"
            }
          ]
        },
        {
          "type": "function_call",
          "name": "view_image",
          "arguments": "{\"path\":\"/tmp/shot0.png\"}",
          "call_id": "c0"
        },
        {
          "type": "function_call_output",
          "call_id": "c0",
          "output": "[screenshot left out: /tmp/shot0.png]"
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_text",
              "text": "now edit the file"
            }
          ]
        }
      ]
    }
  },
